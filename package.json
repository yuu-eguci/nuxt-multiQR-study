{
  "name": "nuxt-multiQR-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "yarn@1.22.22",
  "volta": {
    "node": "24.22.1",
    "yarn": "1.22.22"
  },
  "scripts": {
    "postinstall": "nuxt prepare && node scripts/copy-opencv.mjs",
    "dev": "nuxt dev --dotenv .env.local_",
    "build": "nuxt build --dotenv .env.local_",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate --dotenv .env.local_",
    "generate-for-github-pages": "nuxt generate --dotenv .env.github-pages",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxtjs/i18n": "^10.6.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10",
    "vue-tsc": "^3.3.13"
  }
}
